# DECISION: Sandbox-only public configuration.
BRICKKEN_ENV=sandbox
BRICKKEN_BASE_URL=https://api.sandbox.brickken.com
BRICKKEN_CHAIN_ID=11155111
NEXT_PUBLIC_BRICKKEN_CHAIN_ID=11155111

# DECISION: Server-only secret. Leave empty here; never use NEXT_PUBLIC_ for this variable.
BRICKKEN_API_KEY=

# DECISION: Opt-in authenticated read-only sandbox smoke test. Leave empty.
# Set to 1 only when running `npm run test:brickken-live-read`.
BRICKKEN_LIVE_READS=

# DECISION: Server-only Neon Postgres connection used by the durable repository. Leave empty.
DATABASE_URL=

# DECISION: Opt-in live Neon persistence verification. Leave empty.
# Set to 1 only when running `npm run test:database-live`.
EDICT_DATABASE_LIVE=

# DECISION: Server-only base64url secret for domain-separated run capability and approval challenge MACs.
# Must decode to at least 32 random bytes. Leave empty and never expose through NEXT_PUBLIC_*.
EDICT_RUN_SECURITY_SECRET=

# DECISION: Run APIs remain disabled unless deployment preview access or rate limiting is configured.
# Trusted origin must be an exact HTTPS origin (localhost HTTP is permitted only for local development).
EDICT_RUN_API_ENABLED=
EDICT_TRUSTED_ORIGIN=

# DECISION: Server-only opt-in for TOKENIZE transaction preparation and review.
# Enables no wallet prompt, transaction broadcast, confirmation, polling, or later operation.
EDICT_TRANSACTION_PREPARATION_ENABLED=
